# GEMINI_API_KEY: Diperlukan untuk mengakses fitur asisten keuangan pintar berbasis AI Gemini.
# Daftarkan kunci API Anda di Google AI Studio (kunci API gratis/berbayar).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat aplikasi ini di-host.
# Digunakan untuk tautan referensi mandiri, webhook integrasi bot Telegram, dll.
# Contoh: http://localhost:3000 atau https://laporan-fahkeu.com
APP_URL="MY_APP_URL"
